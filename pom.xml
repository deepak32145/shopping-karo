<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>com.shoppingkaro</groupId>
  <artifactId>shopping-karo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>shopping-karo</name>

  <properties>
    <java.version>21</java.version>
    <!-- Docker Engine 29 needs a newer docker-java than Spring Boot 3.4 manages -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <modules>
    <module>libs/sk-contracts</module>
    <module>libs/sk-common</module>
    <module>libs/sk-resource-server</module>
    <module>services/auth-service</module>
    <module>services/user-service</module>
    <module>services/order-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.shoppingkaro</groupId>
        <artifactId>sk-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.shoppingkaro</groupId>
        <artifactId>sk-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.shoppingkaro</groupId>
        <artifactId>sk-resource-server</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
